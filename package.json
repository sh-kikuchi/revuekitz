{
  "name": "revuekitz",
  "version": "1.4.0",
  "description": "UI component library for Vue.js. I collected atomic and molecular level components based on atomic design.",
  "keywords": [
    "revuekitz",
    "revue",
    "vue",
    "typescript",
    "vue3",
    "vue framework",
    "ui",
    "ui design",
    "ui framework",
    "component framework",
    "component library",
    "ui library",
    "design system",
    "atomic design"
  ],
  "main": "dist/revuekitz.umd.js",
  "module": "dist/revuekitz.es.js",
  "types": "dist/index.d.ts",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sh-kikuchi/revuekitz.git"
  },
  "homepage": "https://sh-revue.net/projects/revuekitz",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/revuekitz.es.js",
      "require": "./dist/revuekitz.umd.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:watch": "vitest --watch",
    "test:unit:ui": "vitest --ui",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@jamescoyle/vue-icon": "^0.1.2",
    "@mdi/js": "^7.4.47",
    "@rollup/plugin-commonjs": "^29.0.3",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.8.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^27.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.2.5",
    "rollup": "^4.18.1",
    "typescript": "^5.8.0",
    "vite": "^6.4.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
